{
  "name": "@silverassist/next-script-loader",
  "version": "0.1.0",
  "description": "Singleton, reference-counted third-party script loader for React/Next.js apps — the shared base recaptcha and every lead-form/vendor-script package build on instead of each hand-rolling the same window-global singleton pattern.",
  "author": "Miguel Colmenares <me@miguelcolmenares.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "prettier": "@silverassist/npm-package-standards/prettier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverAssist/next-script-loader.git"
  },
  "bugs": {
    "url": "https://github.com/SilverAssist/next-script-loader/issues"
  },
  "homepage": "https://github.com/SilverAssist/next-script-loader#readme",
  "keywords": [
    "script-loader",
    "third-party-script",
    "singleton",
    "nextjs",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm run test && npm run build",
    "clean": "rm -rf dist",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "e2e:setup": "next-testing-toolkit build-fixture --port 3214",
    "e2e": "npm run e2e:setup && playwright test -c e2e/playwright.config.ts",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@silverassist/next-testing-toolkit": "^0.2.1",
    "@silverassist/npm-package-standards": "^0.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
